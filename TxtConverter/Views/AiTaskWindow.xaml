<Window x:Class="TxtConverter.Views.AiTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="CanResizeWithGrip"
        Width="920" Height="730" MinWidth="680" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        Title="{DynamicResource ui_ai_window_title}" Background="{StaticResource Brush_WindowBg}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="#333333" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Content -->
            </Grid.RowDefinitions>

            <!-- 1. Header -->
            <Grid Grid.Row="0" Background="{StaticResource Brush_WindowBg}" MouseDown="TitleBar_MouseDown" Height="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0">
                    <Path Data="M19,9l1.25-2.75L23,5l-2.75-1.25L19,1l-1.25,2.75L15,5l2.75,1.25L19,9z M11.5,9.5L9,4L6.5,9.5L1,12l5.5,2.5L9,20l2.5-5.5L17,12L11.5,9.5z"
                          Fill="#0090F0" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource ui_ai_window_title}" FontWeight="Bold" Foreground="#0090F0" FontSize="14" Margin="0,0,10,0"/>
                    <Border Background="#252528" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="3" Padding="8,2" VerticalAlignment="Center">
                        <TextBlock x:Name="ProviderHeaderLabel" Text="(AI Engine)" Foreground="#AAAAAA" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="_" Click="Minimize_Click" Style="{StaticResource TitleBarButton}"/>
                    <Button Content="X" Click="Close_Click" Style="{StaticResource CloseButton}"/>
                </StackPanel>
            </Grid>

            <!-- 2. Content Area -->
            <Grid Grid.Row="1" Margin="15,5,15,15">
                <TabControl Background="Transparent" BorderThickness="0">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border Name="Border" BorderThickness="0,0,0,2" BorderBrush="Transparent" Margin="0,0,18,0" Padding="14,9">
                                            <ContentPresenter x:Name="ContentSite" ContentSource="Header"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Border" Property="BorderBrush" Value="#007ACC"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="False">
                                                <Setter Property="Foreground" Value="#888888"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="#CCCCCC"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>

                    <!-- TAB 1: TASK & CONFIG -->
                    <TabItem Header="{DynamicResource ui_ai_tab_task}">
                        <Grid Margin="0,15,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Model Override Card -->
                                <RowDefinition Height="*"/>    <!-- Task Input Card -->
                                <RowDefinition Height="Auto"/> <!-- Action Footer -->
                            </Grid.RowDefinitions>

                            <!-- Model Settings Card -->
                            <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,12" Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/> <!-- Header Title -->
                                        <RowDefinition Height="Auto"/> <!-- Form Fields -->
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="{DynamicResource ui_ai_model_override}"
                                               Foreground="#888888" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>

                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{DynamicResource ui_settings_model}" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="ModelOverrideBox" Grid.Column="1" IsEditable="True" Height="32"/>

                                        <TextBlock Grid.Column="3" Text="{DynamicResource ui_settings_tokens}" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="BudgetOverrideBox" Grid.Column="4" TextAlignment="Center" Height="32"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Task Input Card -->
                            <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="{DynamicResource ui_ai_describe_task}"
                                               Foreground="White" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10"/>

                                    <!-- Multiline Input with Watermark Overlay -->
                                    <Grid Grid.Row="1">
                                        <TextBox x:Name="PromptBox" Style="{StaticResource MultiLineTextBox}"
                                                 Padding="12,10" FontSize="14" FontFamily="Segoe UI"
                                                 Background="#151515" Foreground="White" BorderBrush="#333333"
                                                 TextChanged="PromptBox_TextChanged"/>

                                        <TextBlock x:Name="PromptWatermark"
                                                   Text="{DynamicResource ui_ai_task_prompt_example}"
                                                   Foreground="#555555" Margin="14,11,0,0" IsHitTestVisible="False"
                                                   FontSize="14" FontStyle="Italic"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Footer -->
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="8" Height="8" CornerRadius="4" Background="#007ACC" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="StatusText" Text="{DynamicResource ui_ai_status_ready}" Foreground="#888888" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="{DynamicResource ui_ai_cancel_btn}" Click="Close_Click" Width="100" Height="36" Margin="0,0,10,0" Background="Transparent" BorderBrush="#444"/>
                                    <Button x:Name="AnalyzeBtn" Content="{DynamicResource ui_ai_analyze_btn}" Click="Analyze_Click" Style="{StaticResource AccentButton}" Width="190" Height="36"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- TAB 2: SYSTEM PROMPT / INSTRUCTIONS EDITOR -->
                    <TabItem Header="{DynamicResource ui_ai_tab_system_prompt}">
                        <Border Style="{StaticResource CardBorder}" Margin="0,15,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Title & Toolbar -->
                                    <RowDefinition Height="*"/>    <!-- Prompt Editor -->
                                    <RowDefinition Height="Auto"/> <!-- Bottom Note -->
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource ui_ai_prompt_rules_title}" FontWeight="Bold" Foreground="White" FontSize="15" Margin="0,0,0,4"/>
                                        <TextBlock Text="{DynamicResource ui_ai_prompt_rules_desc}" Foreground="#888888" FontSize="12"/>
                                    </StackPanel>

                                    <Button Grid.Column="1" Content="{DynamicResource ui_ai_prompt_reset}" Click="ResetPrompt_Click"
                                            Height="30" Padding="12,0" FontSize="12" Background="#2D2D30" BorderBrush="#555555"/>
                                </Grid>

                                <TextBox x:Name="SystemPromptBox" Grid.Row="1" Style="{StaticResource MultiLineTextBox}"
                                         Background="#141414" Foreground="#ECECEC" BorderBrush="#333333"
                                         FontFamily="Consolas" FontSize="12.5" Padding="12"
                                         TextChanged="SystemPromptBox_TextChanged"/>

                                <TextBlock Grid.Row="2" Text="{DynamicResource ui_ai_prompt_saved_hint}"
                                           Foreground="#666666" FontSize="11" Margin="2,8,0,0"/>
                            </Grid>
                        </Border>
                    </TabItem>

                    <!-- TAB 3: REQUEST DEBUG -->
                    <TabItem Header="{DynamicResource ui_ai_tab_request}">
                        <Border Style="{StaticResource CardBorder}" Margin="0,15,0,0">
                            <TextBox x:Name="RequestBox" Style="{StaticResource MultiLineTextBox}" IsReadOnly="True"
                                     Background="#111111" Foreground="#AACCFF" FontFamily="Consolas" FontSize="12"
                                     BorderThickness="0" Padding="12"/>
                        </Border>
                    </TabItem>

                    <!-- TAB 4: RESPONSE DEBUG -->
                    <TabItem Header="{DynamicResource ui_ai_tab_response}">
                        <Border Style="{StaticResource CardBorder}" Margin="0,15,0,0">
                            <TextBox x:Name="ResponseBox" Style="{StaticResource MultiLineTextBox}" IsReadOnly="True"
                                     Background="#111111" Foreground="#AAFFAA" FontFamily="Consolas" FontSize="12"
                                     BorderThickness="0" Padding="12"/>
                        </Border>
                    </TabItem>
                </TabControl>

                <!-- Loading Overlay -->
                <Grid x:Name="LoadingOverlay" Visibility="Collapsed" Background="#D8101012">
                    <Border Background="#1F1F22" BorderBrush="#007ACC" BorderThickness="1" CornerRadius="8" Padding="35"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Width="380">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{DynamicResource ui_ai_thinking_overlay}" Foreground="White" FontWeight="Bold" FontSize="16"
                                       HorizontalAlignment="Center" Margin="0,0,0,18"/>
                            <ProgressBar IsIndeterminate="True" Width="300" Height="6"/>
                            <TextBlock x:Name="LoadingStatus" Text="{DynamicResource ui_ai_building_context}"
                                       Foreground="#CCCCCC" FontSize="13" Margin="0,18,0,0" HorizontalAlignment="Center" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>